            "Title": "AWS Config should be enabled and use the service-linked role for resource recording",
            "Description": "This control checks whether AWS Config is enabled in your account in the current AWS Region, records all resources that correspond to controls that are enabled in the current Region, and uses the service-linked AWS Config role.",
            "Remediation": {
                "Recommendation": {
                    "Text": "Enable AWS Config and use the AWS Config service-linked role for resource recording. Record all resources required for the controls enabled in each Region, including IAM global resources where applicable. In linked Regions, any AWS Config recording mode is acceptable as long as those resources are recorded.",
                    "Url": "https://docs.aws.amazon.com/console/securityhub/Config.1/remediation"
                }
            },
            "ProductFields": {
                "aws/securityhub/ProductName": "Security Hub",
